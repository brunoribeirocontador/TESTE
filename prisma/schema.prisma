generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Esfera {
  FEDERAL
  ESTADUAL
  MUNICIPAL
}

enum StatusParcelamento {
  ATIVO
  QUITADO
  RESCINDIDO
}

enum StatusParcela {
  PENDENTE
  PAGA
}

enum EstagioFunil {
  NOVO_LEAD
  CONTATO_REALIZADO
  PROPOSTA_ENVIADA
  CONTRATO_ENVIADO
  GANHO
  PERDIDO
}

enum OrigemCliente {
  ABERTURA_CNPJ
  MIGRACAO_CONTABILIDADE
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Empresa {
  id            String             @id @default(cuid())
  nome          String
  cnpj          String?            @unique
  origem        OrigemCliente?
  dataConversao DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  parcelamentos Parcelamento[]
  tarefas       TarefaOnboarding[]
  lead          Lead?
}

model Lead {
  id            String          @id @default(cuid())
  nome          String
  empresaNome   String?
  cnpj          String?
  telefone      String?
  email         String?
  origemLead    String?
  tipoServico   OrigemCliente?
  estagio       EstagioFunil    @default(NOVO_LEAD)
  valorProposta Float?
  responsavel   String?
  observacoes   String?
  motivoPerda   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  interacoes    LeadInteracao[]
  empresaId     String?         @unique
  empresa       Empresa?        @relation(fields: [empresaId], references: [id])

  @@index([estagio])
}

model LeadInteracao {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo      String
  descricao String
  createdAt DateTime @default(now())

  @@index([leadId])
}

model TarefaOnboarding {
  id          String       @id @default(cuid())
  empresaId   String
  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo      String
  categoria   String
  status      StatusTarefa @default(PENDENTE)
  ordem       Int          @default(0)
  prazo       DateTime?
  concluidaEm DateTime?
  observacoes String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([empresaId])
  @@index([status])
}

model Parcelamento {
  id             String             @id @default(cuid())
  empresaId      String
  empresa        Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  esfera         Esfera
  orgao          String
  numero         String?
  descricao      String?
  valorTotal     Float
  numeroParcelas Int
  dataInicio     DateTime
  status         StatusParcelamento @default(ATIVO)
  observacoes    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  parcelas       Parcela[]

  @@index([empresaId])
  @@index([esfera])
  @@index([status])
}

model Parcela {
  id             String        @id @default(cuid())
  parcelamentoId String
  parcelamento   Parcelamento  @relation(fields: [parcelamentoId], references: [id], onDelete: Cascade)
  numero         Int
  valor          Float
  vencimento     DateTime
  status         StatusParcela @default(PENDENTE)
  dataPagamento  DateTime?
  valorPago      Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([parcelamentoId])
  @@index([vencimento])
  @@index([status])
}
